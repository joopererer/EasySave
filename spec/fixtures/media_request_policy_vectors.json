{
  "description": "Media request policy verification vectors derived from app/test/media_request_policy_test.dart",
  "rules": [
    {"domain": "tiktok.com", "includeSubdomains": true},
    {"domain": "tiktokcdn.com", "includeSubdomains": true},
    {"domain": "tiktokcdn-eu.com", "includeSubdomains": true},
    {"domain": "tiktokcdn-us.com", "includeSubdomains": true}
  ],
  "urlVectors": [
    {"url": "http://v16-webapp-prime.tiktok.com/a", "expectedCode": "REQUEST_URL_REJECTED"},
    {"url": "https://user:secret@www.tiktok.com/a", "expectedCode": "REQUEST_URL_REJECTED"},
    {"url": "https://@www.tiktok.com/a", "expectedCode": "REQUEST_URL_REJECTED"},
    {"url": "file:///a", "expectedCode": "REQUEST_URL_REJECTED"},
    {"url": "not a URL", "expectedCode": "REQUEST_URL_REJECTED"},
    {"url": "https://tiktok.com.evil.com/path?token=private", "expectedCode": "REQUEST_HOST_REJECTED"},
    {"url": "https://eviltiktok.com/path?token=private", "expectedCode": "REQUEST_HOST_REJECTED"},
    {"url": "https://com/path?token=private", "expectedCode": "REQUEST_HOST_REJECTED"},
    {"url": "https://co.uk/path?token=private", "expectedCode": "REQUEST_HOST_REJECTED"},
    {"url": "https://com.cn/path?token=private", "expectedCode": "REQUEST_HOST_REJECTED"},
    {"url": "https://tiktok.com.co.uk/path?token=private", "expectedCode": "REQUEST_HOST_REJECTED"},
    {"url": "https://instagram.com/path?token=private", "expectedCode": "REQUEST_HOST_REJECTED"},
    {"url": "https://127.0.0.1/path?token=private", "expectedCode": "REQUEST_HOST_REJECTED"},
    {"url": "https://tiktok.com/a", "expectedCode": null},
    {"url": "https://www.tiktok.com/a", "expectedCode": null},
    {"url": "https://v16-webapp-prime.tiktok.com/a", "expectedCode": null},
    {"url": "https://v19-webapp-prime.tiktok.com/a", "expectedCode": null},
    {"url": "https://p16-common-sign.tiktokcdn-eu.com/a", "expectedCode": null},
    {"url": "https://p77-sg.tiktokcdn.com/a", "expectedCode": null},
    {"url": "https://lf16-cdn-tos.tiktokcdn-us.com/a", "expectedCode": null}
