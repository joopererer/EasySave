[
  {
    "id": "xhs",
    "platform": "xiaohongshu",
    "displayName": "小红书",
    "creditName": "小红书",
    "enabled": true,
    "notice": "服务维护中，请稍后再试",
    "minAppVersion": "1.9.0",
    "requiredCapabilities": [],
    "match": {
      "routes": [
        {
          "hosts": [
            {
              "domain": "xiaohongshu.com",
              "includeSubdomains": true
            },
            {
              "domain": "rednote.com",
              "includeSubdomains": true
            }
          ],
          "pathPatterns": [
            "^/(?:explore|discovery/item)/([A-Za-z0-9]+)"
          ]
        },
        {
          "hosts": [
            {
              "domain": "xhs.cn",
              "includeSubdomains": false
            },
            {
              "domain": "xhslink.cn",
              "includeSubdomains": false
            },
            {
              "domain": "xhslink.com",
              "includeSubdomains": false
            }
          ],
          "pathPatterns": [
            "^/(?:(?:a|o)/)?[^/]+/?$"
          ]
        }
      ]
    },
    "shortLinks": [
      {
        "host": {
          "domain": "xhslink.com",
          "includeSubdomains": false
        },
        "strategy": "webview",
        "maxRedirects": 5
      },
      {
        "host": {
          "domain": "xhslink.cn",
          "includeSubdomains": false
        },
        "strategy": "webview",
        "maxRedirects": 5
      },
      {
        "host": {
          "domain": "xhs.cn",
          "includeSubdomains": false
        },
        "strategy": "webview",
        "maxRedirects": 5
      }
    ],
    "normalize": {
      "sourceId": {
        "source": "path",
        "pattern": "^/(?:explore|discovery/item)/([A-Za-z0-9]+)"
      },
      "canonicalTemplate": "https://www.xiaohongshu.com/explore/{id}",
      "preserveLoadQuery": [
        "xsec_token",
        "xsec_source"
      ],
      "exampleId": "670f1a2b000000001e028b12"
    },
    "load": {
      "mode": "webview",
      "timeoutMs": 30000,
      "readyHook": "xhs_ready",
      "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36"
    },
    "auth": {
      "mode": "optional",
      "sessionCookieNames": [
        "web_session"
      ],
      "loginUrl": "https://www.xiaohongshu.com/explore"
    },
    "parserModule": "xhs",
    "download": {
      "mediaHosts": [
        {
          "domain": "xhscdn.com",
          "includeSubdomains": true
        },
        {
          "domain": "xiaohongshu.com",
          "includeSubdomains": true
        }
      ],
      "headers": {
        "Referer": "https://www.xiaohongshu.com/"
      },
      "cookieDomains": [],
      "transport": "background",
      "resumable": true
    },
    "metadata": {
      "authorIdRule": "opaque"
    },
    "icon": {
      "assetKey": "xhs"
    }
  },
