  {
    "id": "tiktok",
    "platform": "tiktok",
    "displayName": "TikTok",
    "creditName": "TikTok",
    "enabled": true,
    "notice": "服务维护中，请稍后再试",
    "minAppVersion": "1.9.0",
    "requiredCapabilities": [],
    "match": {
      "routes": [
        {
          "hosts": [
            {
              "domain": "tiktok.com",
              "includeSubdomains": true
            }
          ],
          "pathPatterns": [
            "^/(?:@[^/]*/(?:video|photo)/([0-9]+)|share/video/([0-9]+)|v/([0-9]+)\\.html)/?$",
            "^/t/[^/]+/?$"
          ]
        },
        {
          "hosts": [
            {
              "domain": "vm.tiktok.com",
              "includeSubdomains": false
            },
            {
              "domain": "vt.tiktok.com",
              "includeSubdomains": false
            }
          ],
          "pathPatterns": [
            "^/[^/]+/?$"
          ]
        }
      ]
    },
    "shortLinks": [
      {
        "host": {
          "domain": "vm.tiktok.com",
          "includeSubdomains": false
        },
        "strategy": "webview",
        "maxRedirects": 5,
        "historyStrategy": "http"
      },
      {
        "host": {
          "domain": "vt.tiktok.com",
          "includeSubdomains": false
        },
        "strategy": "webview",
        "maxRedirects": 5,
        "historyStrategy": "http"
      },
      {
        "host": {
          "domain": "tiktok.com",
          "includeSubdomains": true
        },
        "strategy": "webview",
        "historyStrategy": "http",
        "pathPatterns": [
          "^/t/[^/]+/?$"
        ],
        "maxRedirects": 5
      }
    ],
    "normalize": {
      "sourceId": {
        "source": "path",
        "pattern": "^/(?:@[^/]*/(?:video|photo)/([0-9]+)|share/video/([0-9]+)|v/([0-9]+)\\.html)/?$"
      },
      "canonicalTemplate": "https://www.tiktok.com/@/video/{id}",
      "preserveLoadQuery": [],
      "exampleId": "1234567890123456789"
    },
    "load": {
      "mode": "webview",
      "timeoutMs": 30000,
      "readyHook": "tiktok_ready",
      "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
    },
    "auth": {
      "mode": "optional",
      "sessionCookieNames": [
        "sessionid",
        "sessionid_ss"
      ],
      "loginUrl": "https://www.tiktok.com/login",
      "externalGoogleNotice": true,
      "loginHint": "请选择 TikTok 的手机号 / 邮箱 / 用户名登录。Google 授权暂不支持在此页面完成。成功后点右上角“完成”。",
      "externalGoogleMessage": "Google 授权不能在此内嵌登录页完成。请返回 TikTok，选择“手机号 / 邮箱 / 用户名”登录。如果使用 Gmail 地址，请输入 TikTok 账号密码，不是 Google 密码。在外部浏览器登录也不会自动同步到 EasySave。"
    },
    "parserModule": "tiktok",
    "download": {
      "mediaHosts": [
        {
          "domain": "tiktok.com",
          "includeSubdomains": true
        },
        {
          "domain": "tiktokcdn.com",
          "includeSubdomains": true
        },
        {
          "domain": "tiktokcdn-eu.com",
          "includeSubdomains": true
        },
        {
          "domain": "tiktokcdn-us.com",
          "includeSubdomains": true
        }
      ],
      "headers": {
        "Referer": "https://www.tiktok.com/"
      },
      "cookieDomains": [
        "tiktok.com"
      ],
      "urlOrder": "primaryFirst",
      "transport": "session",
      "resumable": false,
      "resourceDefaults": {
        "image": {
          "cookieDomains": [],
          "transport": "background",
          "resumable": true
        },
        "poster": {
          "cookieDomains": [],
          "transport": "background",
          "resumable": true
        }
      }
    },
    "metadata": {
      "authorIdRule": "numeric"
    },
    "icon": {
      "assetKey": "tiktok"
    },
    "tagColor": "#0F1419",
    "previewErrorMessage": "TikTok 在线预览可能受平台限制，请下载后观看"
  },
