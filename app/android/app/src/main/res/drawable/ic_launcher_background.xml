<?xml version="1.0" encoding="utf-8"?>
<!-- Android adaptive icon background layer.
    135-degree linear gradient: #FC494C (top-right of the square)
                                    → #FA662E (bottom-left of the square).
    The diagonal runs from the top-right corner to the bottom-left corner,
    which on Android's counter-clockwise angle system corresponds to 315°
    (clockwise from left).  We use explicit x1/y1/x2/y2 instead.

    Math: diagonal of 108²+108² = 152.7; half-diagonal offset from centre:
         (±54·sin(45°), ∓54·sin(45°)) = (±38.18, ∓38.18).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="15.82"
                android:startY="15.82"
                android:endX="92.18"
                android:endY="92.18">
                <item android:offset="0"   android:color="#FC494C" />
                <item android:offset="1"   android:color="#FA662E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
