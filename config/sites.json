[
  {
    "id": "xhs",
    "platform": "xiaohongshu",
    "aliases": ["rednote"],
    "displayName": "小红书",
    "creditName": "小红书",
    "enabled": true,
    "notice": "服务维护中，请稍后再试",
    "minAppVersion": "1.9.0",
    "requiredCapabilities": [],
    "match": {
      "routes": [
        {
          "hosts": [
            {
              "domain": "xiaohongshu.com",
              "includeSubdomains": true
            },
            {
              "domain": "rednote.com",
              "includeSubdomains": true
            }
          ],
          "pathPatterns": [
            "^/(?:explore|discovery/item|user/profile/[^/]+)/([A-Za-z0-9]+)"
          ]
        },
        {
          "hosts": [
            {
              "domain": "xhs.cn",
              "includeSubdomains": false
            },
            {
              "domain": "xhslink.cn",
              "includeSubdomains": false
            },
            {
              "domain": "xhslink.com",
              "includeSubdomains": false
            }
          ],
          "pathPatterns": [
            "^/(?:(?:a|o)/)?[^/]+/?$"
          ]
        }
      ]
    },
    "shortLinks": [
      {
        "host": {
          "domain": "xhslink.com",
          "includeSubdomains": false
        },
        "strategy": "http",
        "fallbackStrategy": "webview",
        "maxRedirects": 5
      },
      {
        "host": {
          "domain": "xhslink.cn",
          "includeSubdomains": false
        },
        "strategy": "http",
        "fallbackStrategy": "webview",
        "maxRedirects": 5
      },
      {
        "host": {
          "domain": "xhs.cn",
          "includeSubdomains": false
        },
        "strategy": "http",
        "fallbackStrategy": "webview",
        "maxRedirects": 5
      }
    ],
    "normalize": {
      "sourceId": {
        "source": "path",
        "pattern": "^/(?:explore|discovery/item|user/profile/[^/]+)/([A-Za-z0-9]+)"
      },
      "canonicalTemplate": "https://www.xiaohongshu.com/explore/{id}",
      "preserveLoadQuery": [
        "xsec_token",
        "xsec_source"
      ],
      "exampleId": "670f1a2b000000001e028b12"
    },
    "load": {
      "mode": "webview",
      "timeoutMs": 30000,
      "readyHook": "xhs_ready",
      "terminalPages": [
        {
          "category": "home",
          "code": "UNSUPPORTED_URL",
          "message": "不支持的页面类型"
        },
        {
          "category": "login",
          "code": "LOGIN_REQUIRED",
          "message": "小红书要求登录，请在 App 内登录后重试"
        },
        {
          "category": "captcha",
          "code": "LOGIN_REQUIRED",
          "message": "小红书要求登录，请在 App 内登录后重试"
        },
        {
          "category": "404",
          "code": "POST_NOT_FOUND",
          "message": "帖子不存在，或链接已失效"
        }
      ],
      "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36"
    },
    "auth": {
      "mode": "optional",
      "sessionCookieNames": [
        "web_session",
        "customer-sso-sid",
        "galaxy_creator_session_id",
        "login_token"
      ],
      "loginUrl": "https://www.xiaohongshu.com/login",
      "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36",
      "stateHook": "account",
      "cookieUrls": [
        "https://www.xiaohongshu.com/",
        "https://www.xiaohongshu.com/explore",
        "https://www.rednote.com/",
        "https://www.rednote.com/explore",
        "https://edith.xiaohongshu.com/"
      ],
      "probeUrls": [
        "https://www.xiaohongshu.com/explore",
        "https://www.rednote.com/explore"
      ],
      "openDomains": {
        "xiaohongshu.com": "https://www.xiaohongshu.com/explore/{id}",
        "rednote.com": "https://www.rednote.com/explore/{id}"
      },
      "probeHook": "probeSession",
      "loginHint": "小红书（中国大陆账号）请使用电脑版扫码登录：截屏后用小红书 App 的“扫一扫 → 从相册选择”完成登录。rednote（海外账号）按页面提示登录。只有页面确认已登录后才会自动返回，状态保存在本机。"
    },
    "parserModule": "xhs",
    "download": {
      "mediaHosts": [
        {
          "domain": "xhscdn.com",
          "includeSubdomains": true
        },
        {
          "domain": "xhscdn.net",
          "includeSubdomains": true
        },
        {
          "domain": "xiaohongshu.com",
          "includeSubdomains": true
        }
      ],
      "headers": {
        "Referer": "https://www.xiaohongshu.com/"
      },
      "cookieDomains": [
        "xiaohongshu.com",
        "rednote.com"
      ],
      "transport": "background",
      "resumable": true
    },
    "metadata": {
      "authorIdRule": "opaque"
    },
    "icon": {
      "assetKey": "xhs"
    },
    "tagColor": "#EA1C42"
  },
  {
