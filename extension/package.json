{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "pretest": "wxt prepare && npm run typecheck",
    "test": "vitest run && node --test scripts/build_release.check.js",
    "build:parser": "node scripts/build_parser.js",
    "build:release": "node scripts/build_release.js",
    "build:candidate": "node scripts/build_release.js --candidate"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "wxt": "^0.20.0"
  }
}
