  "headerVectors": [
    {"host": "www.tiktok.com", "headers": {"Cookie": "secret"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Authorization": "secret"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Host": "secret"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Accept": "secret"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Content-Length": "secret"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Referer ": "secret"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Range\r\nCookie": "secret"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Referer": "good\rbad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Referer": "good\nbad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Referer": "good\u0000bad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Origin": "good\rbad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Origin": "good\nbad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Origin": "good\u0000bad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"User-Agent": "good\rbad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"User-Agent": "good\nbad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"User-Agent": "good\u0000bad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Range": "good\rbad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Range": "good\nbad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Range": "good\u0000bad"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Accept-Encoding": "identity"}, "expectedCode": null},
    {"host": "www.tiktok.com", "headers": {"accept-encoding": "gzip"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"accept-encoding": "br"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"accept-encoding": "gzip, identity"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"accept-encoding": ""}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"accept-encoding": "identity "}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"If-Range": "\"etag-1234\""}, "expectedCode": null},
    {"host": "www.tiktok.com", "headers": {"If-Range": "W/\"etag-weak\""}, "expectedCode": null},
    {"host": "www.tiktok.com", "headers": {"If-Range": "Wed, 21 Oct 2015 07:28:00 GMT"}, "expectedCode": null},
    {"host": "www.tiktok.com", "headers": {"if-range": "unquoted-etag"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"if-range": "\"etag\"\r\nInjected: 1"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"if-range": "bad date"}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"if-range": ""}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"if-range": "   "}, "expectedCode": "REQUEST_HEADER_REJECTED"},
    {"host": "www.tiktok.com", "headers": {"Range": "bytes=0-", "range": "bytes=1-"}, "expectedCode": "REQUEST_HEADER_REJECTED"}
  ]
}

